// 布局 / 间距 / 阴影 / 模糊

layout {
    gaps 6

    center-focused-column "never"

    // niri 滚动平铺:列宽用预设比例循环切换
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // 焦点高亮环
    // 颜色暂为固定值;到 matugen 步骤,可让 matugen 渲染一个含
    //   layout { focus-ring { active-color "..." } } 的片段文件,
    //   再在 config.kdl 里 include 进来 —— section 会自动合并。
    focus-ring {
        width 2
        active-color "#00000000"
        inactive-color "#00000000"
    }

    // niri 同时有 border(画在窗口内侧)和 focus-ring(画在外侧)。
    border {
        off
    }

    // 对应 decoration { shadow {} }
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000040"
    }

    // 屏幕四边间距 —— 给 qs 的边框 bar 留位:
    //   top = bar 高度(qs Bar.qml bar.barHeight)
    //   左/右/下 = 细边框厚度(qs Bar.qml bar.sideFrame)
    // 注意:qs 的 PanelWindow 由于 4 边都 anchor、exclusive-zone 失效,只能靠这里 reserve。
    struts {
        top 44
        left 8
        right 8
        bottom 8
    }
}

// 模糊
// 全局 blur {} 只设参数;真正生效要靠 rules.kdl 里 background-effect { blur true },
// 或应用自己通过 ext-background-effect 协议请求。窗口必须半透明才看得到。
blur {
    passes 3            // 层数越多越柔和、越耗 GPU
    offset 3.0          // 每层像素偏移,越大越柔和且几乎不额外耗 GPU
    noise 0.04          // 减少色带
    saturation 1.3      // 模糊背景的饱和度(>1 增艳)
    // off               // 取消注释可全局禁用模糊
}
